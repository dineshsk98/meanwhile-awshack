# Every name below must be present in .env at the repo root. Names marked (optional) may be left empty.
# Relative paths are taken from the repo root.

# (optional) Gemini key, for gemini:<model-id> models
GEMINI_API_KEY=

# Models: ollama:<name>, ollama-cpu:<name> (kept off the GPU), gemini:<model-id> or sagemaker:<endpoint-name>
MEANWHILE_ORDER_MODEL=ollama:qwen3.5:4b
MEANWHILE_VISION_MODEL=ollama:qwen3.5:4b
MEANWHILE_VIDEO_MODEL=ollama:qwen3.5:4b
OLLAMA_URL=http://127.0.0.1:11434

# sagemaker: models use this AWS profile and region. (optional) Leave the profile empty on an EC2 box to use its instance role.
MEANWHILE_AWS_PROFILE=meanwhile
MEANWHILE_AWS_REGION=ap-south-1

# Face ID with Amazon Rekognition, on the profile and region above: on or off (off: nobody is named by face).
# Turn it on once the collection exists. Registered photos are indexed.
MEANWHILE_FACES=off
# Your own Rekognition collection's id (each setup creates its own, e.g. aws rekognition create-collection)
MEANWHILE_FACE_COLLECTION=<your-collection>
# Lowest match similarity (percent) that names a person
MEANWHILE_FACE_MATCH_THRESHOLD=90
# Margin around a person's upper body (share of the box), and the share of the person box from the top that is the upper body
MEANWHILE_FACE_CROP_MARGIN=0.3
MEANWHILE_FACE_UPPER_BODY=0.5
# Tries per person track while no face is found, and seconds between them; after that the episode's majority names it
MEANWHILE_FACE_RETRIES=3
MEANWHILE_FACE_RETRY_GAP_S=1
# Registered photos are scaled down to this longest side (pixels) before they are stored and indexed
MEANWHILE_FACE_PHOTO_MAX_SIDE=1280
# A face that matches nobody: on keeps it as a new unnamed person (one face and one photo) to be named later; off only searches
MEANWHILE_FACE_KEEP_UNNAMED=on
# Unnamed people not seen for this many days are deleted with their faces and photos
MEANWHILE_FACE_UNNAMED_DAYS=14
# Clip events: how many of the clip's sampled frames nearest an event are tried until one shows a named face, and the
# margin around each face found in a frame (share of the face box) for its search
MEANWHILE_FACE_CLIP_FRAMES=3
MEANWHILE_FACE_CLIP_MARGIN=1.0
# The recent past: each camera's heartbeat thumbnails of the last RECENT_WINDOW_S seconds are kept (at most
# RECENT_MAX_FRAMES per camera), session or not, so "what did I do?" can be answered; a question sends at most
# RECENT_MODEL_FRAMES of them, spread over the window and the cameras, to the video model (the SageMaker endpoint
# takes 8 images per prompt)
MEANWHILE_RECENT_WINDOW_S=300
MEANWHILE_RECENT_MAX_FRAMES=120
MEANWHILE_RECENT_MODEL_FRAMES=8
# How long a thing's stored status ("the front door: locked", from a watch's event or a video check) is trusted, in
# seconds; after that "is the front door locked?" checks the video again
MEANWHILE_STATE_MAX_AGE_S=600
# (optional) The person id (the name in lower case, spaces as hyphens) of the user Alexa talks to, called "you";
# registering that person always makes them the owner. Empty: whoever is registered with the owner role
MEANWHILE_OWNER_ID=

# Where the database and uploaded media live
MEANWHILE_DATA=backend/.data

# Dev server ports: HTTP, and HTTPS for phone cameras with --lan
MEANWHILE_PORT=8100
MEANWHILE_LAN_PORT=8443

# Shared key for every /api route (sent as X-Meanwhile-Key), 16+ random characters. Required: the core won't start
# without it. Generate one locally (it isn't printed): see "Run locally" in README.md
MEANWHILE_KEY=
# Device pairing (QR codes instead of the shared key): seconds a one-time pairing code lasts; at most TRIES pairing
# attempts per client address in WINDOW_S seconds; days a paired browser's cookie lasts
MEANWHILE_PAIR_CODE_TTL_S=120
MEANWHILE_PAIR_TRIES=10
MEANWHILE_PAIR_TRIES_WINDOW_S=60
MEANWHILE_PAIR_COOKIE_DAYS=30
# Requests with a wrong key or token: at most TRIES per client address in WINDOW_S seconds, then 429 until the
# window has passed
MEANWHILE_AUTH_FAIL_TRIES=30
MEANWHILE_AUTH_FAIL_WINDOW_S=60
# Media links (clips, frames, thumbnails, photos) are signed and open without the key for at least this many seconds
MEANWHILE_MEDIA_URL_TTL_S=3600
# (optional) The domain a paired browser's cookie covers, with its subdomains (on the box: the main host, so the
# alexa. host is covered too); empty means only the host that paired it
MEANWHILE_PAIR_COOKIE_DOMAIN=
# (optional) The public base URL in pairing links (on the box: https://<host>); empty means the request's own address
MEANWHILE_PUBLIC_URL=
# (optional) Path to a Firebase service-account JSON file; empty means push is off
MEANWHILE_FCM_SERVICE_ACCOUNT=
# Firebase Cloud Messaging HTTP v1: the OAuth scope and the send URL ({project} is filled in)
MEANWHILE_FCM_SCOPE=https://www.googleapis.com/auth/firebase.messaging
MEANWHILE_FCM_SEND_URL=https://fcm.googleapis.com/v1/projects/{project}/messages:send

# How the focus camera is followed: vision (a vision-model check per uploaded frame) or detector (YOLOE tracks on live frames)
MEANWHILE_TRACKING=detector
# Detector: the folder holding the weights and text encoder, their file names, input size, confidence floor
MEANWHILE_DETECTOR_MODEL=yoloe-26m-seg.pt
MEANWHILE_DETECTOR_WEIGHTS=weights/detector
MEANWHILE_DETECTOR_TEXT_ENCODER=mobileclip2_b.ts
MEANWHILE_DETECTOR_IMGSZ=640
MEANWHILE_DETECTOR_CONF=0.05
# Run the detector on every Nth live frame
MEANWHILE_DETECTOR_STRIDE=2
# (optional) cuda or cpu; empty means cuda when available
MEANWHILE_DETECTOR_DEVICE=
# Vision-model checks with detector tracking (on or off): one look before a heads-up, and a crop check for a new track
MEANWHILE_CHECKS=on
# Seconds a heads-up waits for its check before it is sent anyway
MEANWHILE_CHECK_TIMEOUT_S=4
# The vision model locating the object when the detector loses it (on or off; needs checks on): ask after this many
# seconds with no detector lock, at most once per GAP_S while it should be in view and once per MISSING_GAP_S while it
# is missing (0 = not while missing); an answer not back within WAIT_S counts as not found
MEANWHILE_LOCATE=on
MEANWHILE_LOCATE_AFTER_S=1
MEANWHILE_LOCATE_GAP_S=1
MEANWHILE_LOCATE_MISSING_GAP_S=5
MEANWHILE_LOCATE_WAIT_S=4
# A box cut by the frame's edge counts as the object only if it is at least this share of the object's known size
MEANWHILE_EDGE_PART=0.5
# The step-away box as a visual prompt for the detector (on or off), added to the object's words with this weight
# when the words alone detect it too weakly to start a track
MEANWHILE_VISUAL_PROMPT=on
MEANWHILE_VISUAL_PROMPT_WEIGHT=1.0
# With detector tracking, the followed camera's clips also go to the video model for anything else done to the object
# (turned on, opened…) besides the tracker's moves (on or off; off: they only join the events they cover)
MEANWHILE_OBJECT_CLIP_ACTIONS=on

# Camera page video: a person's live view (scale-down factor, bits/s, frames/s), and the detector's ingest
# (the frame's short side in pixels, whichever way the phone is held; bits/s; frames/s)
MEANWHILE_LIVE_SCALE_DOWN=2
MEANWHILE_LIVE_MAX_BITRATE=800000
MEANWHILE_LIVE_MAX_FPS=20
MEANWHILE_INGEST_SHORT_SIDE=360
MEANWHILE_INGEST_MAX_BITRATE=2000000
MEANWHILE_INGEST_MAX_FPS=20
# ICE servers for the core's own WebRTC viewers and the camera pages (comma-separated stun:/turn:/turns: URLs).
# (optional) A turn: URL uses the username and credential below.
MEANWHILE_ICE_SERVERS=stun:stun.l.google.com:19302
MEANWHILE_TURN_USERNAME=
MEANWHILE_TURN_CREDENTIAL=

# SageMaker vision endpoint scripts (infra/sagemaker), run from the laptop
MEANWHILE_SM_AWS_PROFILE=meanwhile
MEANWHILE_SM_AWS_REGION=ap-south-1
MEANWHILE_SM_NAME=meanwhile-qwen3vl
MEANWHILE_SM_ROLE=meanwhile-sagemaker-exec
MEANWHILE_SM_INSTANCE=ml.g6.xlarge
MEANWHILE_SM_HF_MODEL=Qwen/Qwen3-VL-8B-Instruct-FP8
# AWS's Deep Learning Containers registry account for the region, and the LMI image tag
MEANWHILE_SM_DLC_ACCOUNT=763104351884
MEANWHILE_SM_LMI_TAG=0.38.0-lmi29.0.0-cu130
MEANWHILE_SM_STARTUP_TIMEOUT_S=1800
# LMI container options: each MEANWHILE_SM_OPT_<NAME> is passed to the container as OPTION_<NAME>
MEANWHILE_SM_OPT_ASYNC_MODE=true
MEANWHILE_SM_OPT_ROLLING_BATCH=disable
MEANWHILE_SM_OPT_ENTRYPOINT=djl_python.lmi_vllm.vllm_async_service
MEANWHILE_SM_OPT_TENSOR_PARALLEL_DEGREE=1
MEANWHILE_SM_OPT_MAX_MODEL_LEN=16384
MEANWHILE_SM_OPT_MAX_ROLLING_BATCH_SIZE=4
MEANWHILE_SM_OPT_GPU_MEMORY_UTILIZATION=0.90
MEANWHILE_SM_OPT_LIMIT_MM_PER_PROMPT={"image": 8, "video": 0}
MEANWHILE_SM_OPT_TRUST_REMOTE_CODE=false

# Cloud box deploy (infra/cloud/deploy.ps1), run from the laptop. NAME names the SSH key file <NAME>.pem and the box's
# known-hosts file in MEANWHILE_SECRETS_DIR
MEANWHILE_CLOUD_NAME=meanwhile-core
# The box's public address (its Elastic IP), used by deploy.ps1 for SSH
MEANWHILE_CLOUD_PUBLIC_IP=
# The box's public host name, e.g. meanwhile.example.com (DNS A records for it and alexa.<host> point at the Elastic
# IP): deploy.ps1 passes it to the box for Caddy's sites and certificates, MEANWHILE_PUBLIC_URL and the cookie domain
MEANWHILE_CLOUD_PUBLIC_HOST=
# A folder outside the repo that holds the SSH key file and the known-hosts file
MEANWHILE_SECRETS_DIR=
