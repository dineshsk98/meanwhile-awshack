# /etc/meanwhile/install.env on the box: what install.sh installs and where it downloads it from.
# install.sh copies this file there on its first run; edit that copy to change a value, then run install.sh again.
MEANWHILE_PYTHON="3.11"
# System packages (space-separated): OpenCV needs libGL and GLib (libglib2.0-0t64 on Ubuntu 24.04 and later); git installs the CLIP fork
MEANWHILE_APT_PACKAGES="libgl1 libglib2.0-0t64 curl git"
# Ollama models to pull (space-separated), where Ollama listens, and how long it keeps a model loaded
MEANWHILE_OLLAMA_MODELS="qwen3.5:4b"
MEANWHILE_OLLAMA_HOST="127.0.0.1:11434"
MEANWHILE_OLLAMA_KEEP_ALIVE="24h"
MEANWHILE_UV_INSTALL_URL="https://astral.sh/uv/install.sh"
MEANWHILE_OLLAMA_INSTALL_URL="https://ollama.com/install.sh"
MEANWHILE_CADDY_DOWNLOAD_URL="https://caddyserver.com/api/download?os=linux&arch=amd64"
