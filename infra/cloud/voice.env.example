# /etc/meanwhile/voice.env on the box (mode 600, root): the voice side's settings. Every name must be present
# (meanings in voice/.env.example); the key comes from key.env as MEANWHILE_CORE_KEY.
MEANWHILE_CORE_URL=http://127.0.0.1:8101
OLLAMA_URL=http://127.0.0.1:11434
ALEXA_SIM_MODEL=qwen3.5:4b
# Internal port behind Caddy
MEANWHILE_VOICE_PORT=8001
# The home's time zone for spoken times (the box itself runs in UTC)
MEANWHILE_TIME_ZONE=Asia/Kolkata
