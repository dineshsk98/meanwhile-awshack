# Every name below must be set in voice/.env.
# Relative paths are taken from the voice/ folder.

# Where Ollama answers (the simulated Alexa panel's model)
OLLAMA_URL=http://127.0.0.1:11434
# The model the simulated Alexa panel uses to pick a tool
ALEXA_SIM_MODEL=qwen3.5:4b
# The core the voice side talks to, and the shared key it sends: the core's MEANWHILE_KEY (required; keep it in
# voice/.env only)
MEANWHILE_CORE_URL=http://127.0.0.1:8100
MEANWHILE_CORE_KEY=
# The voice dev server's port
MEANWHILE_VOICE_PORT=8000
# The home's time zone (IANA name) for spoken times; the server may run in UTC
MEANWHILE_TIME_ZONE=Asia/Kolkata

